# Copy this file to .env and fill in real values for local docker-compose runs.
# .env is gitignored — never commit real secrets. docker-compose automatically
# loads .env from this same directory (no --env-file flag needed for local dev).
# For CI/production, inject these as real environment variables / secrets instead
# of a checked-in .env file.

# SQL Server "sa" password — used by every service's ConnectionStrings__* in docker-compose.yml
SA_PASSWORD=ChangeMe_LocalDevOnly!

# Key that encrypts one-time secrets (2FA codes, reset / confirmation links in the Identity outbox) and webhook secrets.
# IdentityService and NotificationService must have the SAME value. Generate: openssl rand -base64 32
# Changing it makes undelivered messages / stored webhook secrets unreadable.
SETTINGS_ENCRYPTION_KEY=ChangeMe_LocalDevOnly_32+chars_random

# RabbitMQ password — used by rabbitmq and every service's RabbitMQ__Password
RABBITMQ_PASSWORD=ChangeMe_LocalDevOnly!


# ChatBotService's two LLM providers — see docs/business/Identity/License.md and
# ModuleCodes.ChatBotPremium: tenants without the premium license flag are routed to
# OpenAi/gpt-4o-mini instead of Anthropic.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: use a SQL Server installed on the host instead of the "sqlserver" container.
# Set SQL_HOST=host.docker.internal and start with
#   docker compose -f docker-compose.yml -f docker-compose.localsql.yml up -d --build
# SA_PASSWORD must then be the host instance's sa password. Leave unset for the container.
#SQL_HOST=host.docker.internal
