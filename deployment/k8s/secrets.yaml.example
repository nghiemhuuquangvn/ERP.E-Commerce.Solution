# Copy to secrets.yaml (gitignored) and fill in real values before applying, OR
# skip this file entirely and create the secret directly from your .env:
#   kubectl create secret generic erp-secrets --from-env-file=.env -n erp
# In production, prefer a real secrets manager (Azure Key Vault, AWS Secrets
# Manager, HashiCorp Vault, Sealed Secrets) over any plaintext-in-cluster Secret.
apiVersion: v1
kind: Secret
metadata:
  name: erp-secrets
  namespace: erp
type: Opaque
stringData:
  # SQL Server on host machine
  sql-auth-db:        "Server=host.docker.internal,1433;Database=AuthDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-sales-db:       "Server=host.docker.internal,1433;Database=SalesDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-purchasing-db:  "Server=host.docker.internal,1433;Database=PurchasingDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-warehouse-db:   "Server=host.docker.internal,1433;Database=WarehouseDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-accounting-db:  "Server=host.docker.internal,1433;Database=AccountingDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-crm-db:         "Server=host.docker.internal,1433;Database=CrmDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-hrm-db:         "Server=host.docker.internal,1433;Database=HrmDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-masterdata-db:  "Server=host.docker.internal,1433;Database=MasterDataDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-product-db:     "Server=host.docker.internal,1433;Database=ProductDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-payment-db:     "Server=host.docker.internal,1433;Database=PaymentDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-shipping-db:    "Server=host.docker.internal,1433;Database=ShippingDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-pos-db:         "Server=host.docker.internal,1433;Database=PosDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-promotion-db:   "Server=host.docker.internal,1433;Database=PromotionDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-notification-db:"Server=host.docker.internal,1433;Database=NotificationDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  sql-reporting-db:   "Server=host.docker.internal,1433;Database=ReportingDB;User Id=sa;Password=__REPLACE_ME__;TrustServerCertificate=True;Encrypt=False"
  # Broker credentials
  rabbitmq-password: "__REPLACE_ME__"
  # JWT signing key (must match JWT_SIGNING_KEY / Jwt__Key used by IdentityService,
  # the Gateway, and — once Tier 3 rolls out — every downstream service)
  jwt-signing-key: "__REPLACE_ME__"
