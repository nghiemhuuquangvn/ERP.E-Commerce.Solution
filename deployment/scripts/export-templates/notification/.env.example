# Copy to .env and fill in real values before running docker compose up.
# Never commit the real .env file.

# SQL Server "sa" password — must satisfy SQL Server's complexity policy
# (8+ chars, upper+lower+digit+symbol).
SA_PASSWORD=ChangeMe123!

# This service VALIDATES JWTs — it does not issue them. These three values must
# exactly match the signing key/issuer/audience your separate identity/auth
# service used to sign the token, or every authenticated request will 401.
JWT_SIGNING_KEY=ChangeMeToARandom32PlusByteSecretString
JWT_ISSUER=YourAuthService
JWT_AUDIENCE=YourApiAudience

# AES-256 key used to encrypt stored SMTP/SMS provider credentials
# (Tenant/System Email/Sms Settings) at rest. Generate one, e.g.:
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=ChangeMeToARandom32PlusByteSecretString
