# Copy to .env and fill in real values before running docker compose up.
# Never commit the real .env file.

# SQL Server "sa" password — must satisfy SQL Server's complexity policy
# (8+ chars, upper+lower+digit+symbol).
SA_PASSWORD=ChangeMe123!

# No JWT secret: tokens are signed RS256 (and OpenIddict tokens encrypted RSA-OAEP) with
# certificates generated once on the identity_keys volume — see README "Signing keys".
