<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.Authorization, Mvc.Filters, Http, and IMemoryCache all come
         from the shared framework, not a standalone NuGet package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- Shared token-revocation store (TokenRevocation/), same version as ERP.Shared.Caching. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- ITenantProvider/TenantScope (AddRequestTenantProvider) and ERP.Shared.Core. -->
    <ProjectReference Include="..\Infrastructure\Data\ERP.Shared.Data.csproj" />
  </ItemGroup>

</Project>
