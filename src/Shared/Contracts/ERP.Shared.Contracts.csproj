<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) suppressed: these are simple, self-describing
         DTOs/event records where a doc comment would just restate the member name. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <Description>Shared DTOs and integration event contracts for cross-service communication</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Messaging/ERP.Shared.Messaging.csproj" />
  </ItemGroup>

</Project>
