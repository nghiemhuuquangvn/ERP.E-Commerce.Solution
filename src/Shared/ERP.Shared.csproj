<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Exclude sub-project source trees (each has its own .csproj) to avoid duplicate symbol
       errors. Extensions\ and Observability\ have no separate .csproj — they belong to this
       root project and must stay compiled here (AddSerilogLogging/KafkaLogSink live there). -->
  <ItemGroup>
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="Messaging\**\*.cs" />
    <Compile Remove="Contracts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives access to the full ASP.NET Core API surface (RequestLocalizationOptions,
         IRequestCultureProvider, UseRequestLocalization, etc.) from this plain class
         library — the old Microsoft.AspNetCore.Localization NuGet package no longer
         ships compilable types under .NET 10. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.12" />
    <PackageReference Include="Confluent.Kafka" Version="2.13.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\ERP.Shared.Core.csproj" />
    <ProjectReference Include="Messaging\ERP.Shared.Messaging.csproj" />
    <ProjectReference Include="Contracts\ERP.Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- No designer codegen: IStringLocalizer&lt;SharedResource&gt; resolves keys by convention
         from these embedded .resx files without a generated .Designer.cs. Path mirrors the
         SharedResource type's namespace (ERP.Shared.Localization) under ResourcesPath="Resources". -->
    <EmbeddedResource Update="Resources\Localization\SharedResource.vi-VN.resx">
      <DependentUpon>SharedResource.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
