<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Zero-code umbrella (CommonServiceRoadmap.md §7 / Part B1): every concern below now
       lives in its own project with its own explicit dependency list. This project just
       aggregates them via ProjectReference so the other 14 services (which still
       reference this one file) see zero change — everything they used to get from one
       big assembly, they now get transitively through this umbrella instead. Do not add
       .cs files or PackageReferences directly here again; add them to the relevant
       sub-project. -->
  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <EmbeddedResource Remove="**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\ERP.Shared.Core.csproj" />
    <ProjectReference Include="Messaging\ERP.Shared.Messaging.csproj" />
    <ProjectReference Include="Contracts\ERP.Shared.Contracts.csproj" />
    <ProjectReference Include="Authorization\ERP.Shared.Authorization.csproj" />
    <ProjectReference Include="Infrastructure\Caching\ERP.Shared.Caching.csproj" />
    <ProjectReference Include="Infrastructure\Exceptions\ERP.Shared.Exceptions.csproj" />
    <ProjectReference Include="Infrastructure\Data\ERP.Shared.Data.csproj" />
    <ProjectReference Include="Localization\ERP.Shared.Localization.csproj" />
    <ProjectReference Include="Middleware\ERP.Shared.Middleware.csproj" />
    <ProjectReference Include="Observability\ERP.Shared.Observability.csproj" />
    <ProjectReference Include="Extensions\ERP.Shared.Extensions.csproj" />
    <ProjectReference Include="Security\ERP.Shared.Security.csproj" />
    <ProjectReference Include="Versioning\ERP.Shared.Versioning.csproj" />
  </ItemGroup>

</Project>
