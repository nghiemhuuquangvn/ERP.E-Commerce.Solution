{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "ConnectionStrings": {
    "AuthDB": "Server=.;Database=AuthDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cache": {
    "Type": "Memory",
    "InstanceName": "identity"
  },
    "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services",
    "Expired": 60,
    "RefreshTokenExpirationDays": 7
  },
  "PasswordPolicy": {
    "MinLength": 8,
    "HistoryCount": 5,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSymbol": true,
    "MaxFailedAttemptsPerWindow": 10,
    "FailedAttemptsWindowMinutes": 15
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US", "vi-VN" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5000" ]
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092"
  },
  "Tenancy": {
    "BaseDomain": "erp.local",
    "StorefrontBaseDomain": "shop.erp.local",
    "PlatformHost": "admin.erp.local",
    "FallbackTenantCode": ""
  },
  "ForwardedHeaders": {
    "KnownNetworks": [ "127.0.0.0/8", "::1/128" ]
  },
  "Auth": {
    "PasswordResetUrl": "http://localhost:5173/reset-password",
    "PasswordResetTokenExpiryMinutes": 60,
    "EmailConfirmationUrl": "http://localhost:5173/confirm-email",
    "EmailConfirmationTokenExpiryHours": 48,
    "ExposeTokensInResponseForTesting": false
  },
  "AllowedHosts": "*"
}
