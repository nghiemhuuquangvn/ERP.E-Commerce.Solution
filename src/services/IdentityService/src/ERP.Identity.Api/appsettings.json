{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "ConnectionStrings": {
    "AuthDB": "Server=.;Database=AuthDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
    "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services",
    "Key": "CHANGE_ME_SET_VIA_JWT__KEY_ENVIRONMENT_VARIABLE",
    "Expired": 60,
    "RefreshTokenExpirationDays": 7
  },
  "PasswordPolicy": {
    "MinLength": 8,
    "HistoryCount": 5,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSymbol": true,
    "MaxFailedAttemptsPerWindow": 10,
    "FailedAttemptsWindowMinutes": 15
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US", "vi-VN" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:5000" ]
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092"
  },
  "AllowedHosts": "*"
}
