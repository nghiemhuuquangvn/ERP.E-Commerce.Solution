{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "ConnectionStrings": {
    "AuthDB": "Server=.;Database=AuthDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
    "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services",
    "Key": "ERP_Identity_JWT_Signing_Secret_Key_Minimum_256_Bits_Required",
    "Expired": 60,
    "RefreshTokenExpirationDays": 7
  },
  "PasswordPolicy": {
    "MinLength": 8,
    "HistoryCount": 5
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US", "vi-VN" ]
  },
  "AllowedHosts": "*"
}
