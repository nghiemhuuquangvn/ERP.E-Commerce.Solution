{
  "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services",
    "Key": "CHANGE_ME_SET_VIA_JWT__KEY_ENVIRONMENT_VARIABLE"
  },
  "ConnectionStrings": {
    "ShippingDb": "Server=(local);Database=ShippingDB;Trusted_Connection=true;TrustServerCertificate=true;",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "Type": "Memory",
    "InstanceName": "shp"
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US", "vi-VN" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
