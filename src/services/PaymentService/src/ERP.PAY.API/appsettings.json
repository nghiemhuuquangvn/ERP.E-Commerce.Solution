{
  "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services"
  },
  "Security": {
    "SettingsEncryptionKey": "CHANGE_ME_SET_VIA_SECURITY__SETTINGSENCRYPTIONKEY_ENVIRONMENT_VARIABLE"
  },
  "ConnectionStrings": {
    "PaymentDb": "Server=(local);Database=PaymentDB;Trusted_Connection=true;TrustServerCertificate=true;",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "Type": "Memory",
    "InstanceName": "pay"
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US", "vi-VN" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
