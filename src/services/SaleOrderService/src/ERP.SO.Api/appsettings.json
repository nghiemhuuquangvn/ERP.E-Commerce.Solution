{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services"
  },
  "ConnectionStrings": {
    "SalesDb": "Server=(local);Database=SalesDB;Trusted_Connection=true;TrustServerCertificate=true",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "Type": "Memory",
    "InstanceName": "so"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092"
  },
  "Services": {
    "PromotionServiceBaseUrl": "http://localhost:5012"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5002"
      }
    }
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US", "vi-VN" ]
  }
}
