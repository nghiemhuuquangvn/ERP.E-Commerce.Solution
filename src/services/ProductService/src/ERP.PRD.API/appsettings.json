{
  "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services",
    "Key": "CHANGE_ME_SET_VIA_JWT__KEY_ENVIRONMENT_VARIABLE"
  },
  "ConnectionStrings": {
    "ProductDB": "Server=localhost;Database=ProductDB;User Id=sa;Password=YourPassword123;TrustServerCertificate=True;Encrypt=False",
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [ "en-US", "vi-VN" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092",
    "Acks": "All",
    "RetryBackoffMs": 100,
    "MessageTimeoutMs": 30000
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexName": "products"
  },
  "Cache": {
    "Type": "Memory",
    "InstanceName": "product"
  }
}
