{
  "ConnectionStrings": {
    "PurchasingDb": "Server=localhost;Database=PurchasingDB;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-change-this-in-production-at-least-32-characters-long"
  },
  "CacheSettings": {
