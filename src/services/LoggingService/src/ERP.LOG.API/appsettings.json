{
  "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092",
    "Acks": "All",
    "RetryBackoffMs": 100,
    "MessageTimeoutMs": 30000
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexPrefix": "service-logs"
  }
}
