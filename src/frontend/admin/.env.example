# Same origin, always: the tenant is decided by the host the app is served on, so API
# calls must go to <this host>/api (the container nginx / vite dev proxy forward it to
# the Gateway with the Host header intact). Never point this at another host.
VITE_API_URL=/api

# SignalR hubs are also same-origin (/hubs/chat, /hubs/notifications — proxied by the
# container nginx straight to the service). Leave empty. Only for `npm run dev` against
# services started with docker-compose.debug.yml may these point at the published ports.
VITE_CHATBOT_WS_URL=
VITE_NOTIFICATION_WS_URL=

# External login (SSO) — placeholder/example values only. Real OAuth app
# registrations must be created per-environment; these are not live credentials.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/common
VITE_FACEBOOK_APP_ID=your-facebook-app-id
