VITE_API_URL=/api
VITE_TENANT_CODE=SYSTEM
# GUID counterpart of VITE_TENANT_CODE — this storefront is one-tenant-per-build, so this
# is the only tenant it ever needs. Used as ChatBotService's guestTenantId for anonymous chat.
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000
# ChatBotService's own host:port — the chat SignalR hub is exposed directly here, bypassing
# the Gateway (port 5000), because the Gateway doesn't reliably proxy WebSocket upgrades.
# http://localhost:5017 only resolves for a Docker Compose deploy (host port mapping) or
# local `npm run dev` — this build targets the K8s deployment, which routes this dedicated
# Ingress host instead (see deployment/k8s/ingress.yaml's chat.erp.local rule).
VITE_CHATBOT_WS_URL=http://chat.erp.local
