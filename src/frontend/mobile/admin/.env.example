# Copy to .env (git-ignored). The Gateway decides the tenant from the HOST of the request, so the app must call the
# tenant's own host - "localhost" belongs to no tenant and every call is refused. See docs/frontend/mobile-apps.md.
# Local stack (add the host to your hosts file, or use the phone's LAN address mapped to it):
EXPO_PUBLIC_API_URL=http://glcheck.shop.erp.local/api
