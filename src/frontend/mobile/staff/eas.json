{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_URL": "http://shop.glcheck.lan/api"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}
