{
  "expo": {
    "name": "ERP Staff",
    "slug": "erp-staff",
    "version": "1.0.0",
    "scheme": "erp-staff",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0284c7"
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "ERP Staff uses the camera to scan product barcodes." }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
