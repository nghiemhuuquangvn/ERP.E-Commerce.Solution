{
  "IdentityServer": {
    "Authority": "http://localhost:5001",
    "Audience": "api"
  },
  "Jwt": {
    "Issuer": "ERP.Identity",
    "Audience": "ERP.Services",
    "Authority": "http://identityservice:5001"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Ocelot": "Information"
    }
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092"
  },
  "Tenancy": {
    "IdentityUrl": "http://identityservice:5001"
  },
  "StreamingProxy": {
    "MaxRequestBodyBytes": 30000000,
    "Routes": [
      {
        "UpstreamPrefix": "/prd/api/v1/products/import",
        "DownstreamBase": "http://productservice:5008/api/v1/products/import"
      },
      {
        "UpstreamPrefix": "/mst/api/v1/masterdata/employees/import",
        "DownstreamBase": "http://masterdataservice:5015/api/v1/masterdata/employees/import"
      }
    ]
  }
}
